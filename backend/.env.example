DATABASE_URL=postgresql+psycopg://mac@localhost:5432/familyid
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
# OTP: in DEV_MODE the OTP is returned in the API response and printed to the log
DEV_MODE=true
DEMO_OTP=123456
# Cloudinary (leave blank to store files locally under backend/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# SMTP for email OTP (leave blank to disable email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@familyid.gov.in
CORS_ORIGINS=http://localhost:5173
