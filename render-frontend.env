# Frontend environment variable for the TWO-SERVICE layout (DEPLOY.md, Option B). The default
# single-service deployment has no separate frontend service and does not need this file.
# Paste this into the frontend service's Environment tab using "Add from .env", then fix the
# REPLACE_ME value below.
# (Render dashboard → familyid-frontend → Environment → Add Environment Variable → Add from .env)

# REQUIRED — the backend service's Render URL, filled in only after the backend is deployed once.
# e.g. https://familyid-backend-xxxx.onrender.com
API_URL=REPLACE_ME_with_backend_url
