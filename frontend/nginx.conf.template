# Rendered to /etc/nginx/conf.d/default.conf at container start by the base nginx image's
# built-in envsubst step (see /etc/nginx/templates in the Dockerfile). ${PORT} lets the platform
# (Render, or any other PaaS) choose the listen port at run time.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    # Basic hardening; the app itself has no inline scripts/styles requiring a looser CSP.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Runtime-injected config (see docker-entrypoint.sh) — never cache it.
    location = /env-config.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    # Hashed build assets are safe to cache for a long time.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: everything else falls back to index.html, which itself is never cached so a
    # redeploy is picked up immediately.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
