# Backend environment variables for Render — paste this into the service's
# Environment tab using "Add from .env", then fix the three REPLACE_ME values below.
# (Render dashboard → familyid-backend → Environment → Add Environment Variable → Add from .env)

# REQUIRED — get this from the Render Postgres dashboard: familyid-db → Info → Internal Database URL.
# Skip this line entirely if you used the render.yaml Blueprint — it fills DATABASE_URL in for you.
DATABASE_URL=REPLACE_ME_with_internal_database_url

# REQUIRED — any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME_with_a_random_secret

# REQUIRED — the frontend service's Render URL, filled in only after the frontend is deployed once.
# e.g. https://familyid-frontend-xxxx.onrender.com  (comma-separate more than one origin)
CORS_ORIGINS=REPLACE_ME_with_frontend_url

# Safe defaults — leave as-is unless you have a reason to change them.
JWT_EXPIRE_MINUTES=720
DEV_MODE=false
DEMO_OTP=123456
SMTP_PORT=587
SMTP_FROM=noreply@familyid.gov.in
SEED_ON_BOOT=false
SEED_RESET=false

# Optional — leave blank to skip. Without these, uploaded documents are stored on local (ephemeral)
# disk, wiped on every redeploy; set all three to store them in Cloudinary instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — leave blank to disable email OTP delivery (mobile OTP still works without these).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
