# Environment variables for the single Render Web Service (root Dockerfile). Paste into the
# service's Environment tab with "Add from .env", then fix the two REPLACE_ME values.
# (Render dashboard → familyid → Environment → Add Environment Variable → Add from .env)
#
# Skip this file entirely if you deployed with the render.yaml Blueprint: it already sets all of
# these, and fills DATABASE_URL and JWT_SECRET in for you.

# REQUIRED — Render Postgres dashboard: familyid-db → Info → Internal Database URL.
DATABASE_URL=REPLACE_ME_with_internal_database_url

# REQUIRED — any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME_with_a_random_secret

# Safe defaults — leave as-is unless you have a reason to change them.
JWT_EXPIRE_MINUTES=720
DEV_MODE=false
DEMO_OTP=123456
SMTP_PORT=587
SMTP_FROM=noreply@familyid.gov.in
# Frontend and API share one origin, so CORS is not needed for the app itself.
CORS_ORIGINS=
# Load the demo dataset on the first boot (no effect once the database has users). Set back to
# false afterwards. Never set SEED_RESET=true on a database with real data: it drops every table.
SEED_ON_BOOT=true
SEED_RESET=false

# Optional — leave blank to skip. Without these, uploaded documents are stored on local (ephemeral)
# disk, wiped on every redeploy; set all three to store them in Cloudinary instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — leave blank to disable email OTP delivery (mobile OTP still works without these).
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
