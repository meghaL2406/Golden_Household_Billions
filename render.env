# OPTIONAL. The single-service image needs NO environment variables: with none set it runs an
# embedded PostgreSQL, generates its own JWT secret and seeds the demo dataset. Use this file only
# to override defaults on a manually created Web Service (Environment → Add from .env).
#
# Deployed with the render.yaml Blueprint? Skip this file — the blueprint already sets everything.

# Managed Postgres instead of the embedded one (recommended when data must survive deploys):
# Render Postgres dashboard → familyid-db → Info → Internal Database URL.
DATABASE_URL=

# Leave empty to let the container generate and persist one; set to pin it across instances.
JWT_SECRET=

# Defaults — leave as-is unless you have a reason to change them.
JWT_EXPIRE_MINUTES=720
DEV_MODE=true
DEMO_OTP=123456
CORS_ORIGINS=
SEED_ON_BOOT=true
SEED_RESET=false
WEB_CONCURRENCY=2

# Optional — Cloudinary keeps uploaded documents across deploys; leave blank to store them locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — email OTP delivery; leave blank to disable (mobile OTP still works in DEV_MODE).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@familyid.gov.in
